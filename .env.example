# GranaryVault Environment Configuration
# Copy to .env.local and fill in your values

# Stellar Network — set to PUBLIC for Mainnet
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Treasury Contract (deploy to Testnet first)
NEXT_PUBLIC_TREASURY_CONTRACT_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_REALTIME_EVENTS=true
NEXT_PUBLIC_ENABLE_WEBHOOKS=true

# Logging
NEXT_PUBLIC_LOG_LEVEL=debug

# Migration to Mainnet: change STELLAR_NETWORK to PUBLIC and update URLs above.
# No code changes needed — the app reads these at build/runtime.
